// Included in SequencerEngine::Impl. All storage is prepared before audio processing.
 Playing& clipInstance(int id){return id<12?playing[id]:polyPlaying[id-12];}
 double clipBegin(int slot)const{return jlimit(0.,jmax(0.,(double)cv[slot][0]-.0625),(double)cx[slot][0]);}
 double clipEnd(int slot)const{double begin=clipBegin(slot);return cx[slot][1]>begin?jmin((double)cv[slot][0],(double)cx[slot][1]):cv[slot][0];}
 double clipRate(int slot)const{constexpr double rates[]={.5,1,2,4};double rate=rates[jlimit(0,3,(int)cv[slot][2])]*cx[slot][10];if(cx[slot][8]>.5f)rate=jmax(.0625,clipEnd(slot)-clipBegin(slot))*cx[slot][9]*60/processingBpm;if(cx[slot][11]>.5f)rate*=1.5;if(cx[slot][12]>.5f)rate*=2./3;return jlimit(.0001,2048.,rate);}
 double positiveWrap(double value,double length)const{return value-std::floor(value/length)*length;}
 double clipPosition(int slot,Playing& state,bool updateRandom){double begin=clipBegin(slot),end=clipEnd(slot),length=jmax(.0625,end-begin),rate=clipRate(slot),elapsed=jmax(0.,(beat-state.launch)*rate)+state.offset;int mode=(int)cv[slot][1];double cycle=std::floor(elapsed/length),position=positiveWrap(elapsed,length);if(mode==1||mode==2&&((int64)cycle&1))position=length-position;
  if(mode>=4&&mode<=7){double slice=jmin(length,std::pow(2.,cx[slot][13]-2));int count=jmax(1,(int)std::ceil(length/slice));int64 epoch=(int64)std::floor(elapsed/(mode>=6?length:slice));if(updateRandom&&epoch!=state.randomEpoch){state.randomEpoch=epoch;int index=random.nextInt(count);if(mode==5&&count>1){index=random.nextInt(count-1);if(index>=state.randomSlice)++index;}state.randomSlice=index;}if(mode==4||mode==5)position=jmin(length-1.e-8,state.randomSlice*slice+positiveWrap(elapsed,slice));else if(mode==6){double start=jmin(length-slice,state.randomSlice*slice);position=start+positiveWrap(elapsed,jmax(.0625,length-start));}else {double stop=jmin(length,(state.randomSlice+1)*slice);position=positiveWrap(elapsed,jmax(.0625,stop));}}
  if(mode==8)position=positiveWrap(state.offset,length);return begin+jlimit(0.,length,position);
 }
 void stopClipInstance(int id,int sample){auto& state=clipInstance(id);state.on=false;state.pending=-1;for(auto& note:clipNotes)if(note.end>=0&&note.instance==id){clipEmit(MidiMessage::noteOff(note.channel,note.note),sample);note.end=-1;note.bank.reset();}}
 void stopClip(int slot,int sample){stopClipInstance(slot,sample);for(int i=12;i<76;++i)if(clipInstance(i).clipSlot==slot)stopClipInstance(i,sample);}
 void requestClip(int slot,int sample,double hostOffset,bool toggle=true,int triggerNote=-1,int channel=1,float velocity=1,int polyId=-1){if(slot<0||slot>11)return;int id=polyId>=12?polyId:slot;auto& state=clipInstance(id);if(v("seqClipPoly")<.5f)for(int other=0;other<76;++other)if(other!=id&&clipInstance(other).pending>=0&&!(cv[slot][4]==2&&clipInstance(other).clipSlot==slot))stopClipInstance(other,sample);if(toggle&&(state.on||state.pending>=0)){stopClipInstance(id,sample);return;}if(state.on||state.pending>=0)stopClipInstance(id,sample);state={};state.clipSlot=slot;state.triggerNote=triggerNote;state.triggerChannel=channel;state.velocity=velocity;int quant=(int)cx[slot][4];double grid=0;if(quant==0){int global=(int)v("seqQuant");grid=global==1?.25:global==2?1:global==3?4:0;}else {double grids[]={0,0,.25,1,4,8,16};grid=grids[jlimit(0,6,quant)];}state.pending=grid>0?std::ceil((beat+hostOffset-1.e-8)/grid)*grid-hostOffset:beat;}
 int clipMemberChannel()const{for(int c=2;c<=16;++c){bool busy=false;for(auto& note:clipNotes)busy|=note.end>=0&&note.channel==c;for(auto& note:arpNotes)busy|=note.end>=0&&note.channel==c;for(int count:combined[c-1])busy|=count>0;if(!busy)return c;}return 0;}
 void clipExpression(Active& active,int sample,bool initial){auto& note=active.bank->clips[active.sourceSlot].notes[active.source];if(initial){for(auto cc:std::array<std::pair<int,int>,4>{{{101,0},{100,0},{6,24},{100,127}}})clipEmit(MidiMessage::controllerEvent(active.channel,cc.first,cc.second),sample);clipEmit(MidiMessage::controllerEvent(active.channel,74,roundToInt(note.expressionX*127)),sample);clipEmit(MidiMessage::controllerEvent(active.channel,71,roundToInt(note.expressionY*127)),sample);clipEmit(MidiMessage::channelPressureChange(active.channel,roundToInt(note.expressionZ*127)),sample);}double fraction=jlimit(0.,1.,active.curveOffset+(1-active.curveOffset)*(beat-active.begin)/jmax(.00001,active.end-active.begin));float bend=sequenceCurveValue(note.pitchCurve,fraction);clipEmit(MidiMessage::pitchWheel(active.channel,jlimit(0,16383,8192+roundToInt(bend/24*8191))),sample);}
 void playClipNote(std::shared_ptr<const SequencerBank> bank,int slot,int index,int instance,int sample,double position){auto& state=clipInstance(instance);auto& note=bank->clips[slot].notes[index];if(note.muted||note.chance<=0||random.nextFloat()>note.chance)return;int pitch=note.pitch+(int)cv[slot][3]+(int)v("transpose")+state.shift+(note.octaveRandom>=1?random.nextInt(roundToInt(note.octaveRandom)+1)*12:0);if(pitch<0||pitch>127)return;bool mpe=!note.pitchCurve.empty()||note.expressionX!=0||note.expressionY!=0||note.expressionZ!=0;int channel=mpe?clipMemberChannel():note.channel;if(channel==0)return;
  auto active=std::find_if(clipNotes.begin(),clipNotes.end(),[](auto& n){return n.end<0;});if(active==clipNotes.end()){if(clipNotes.size()>=2048)return;clipNotes.push_back({});active=clipNotes.end()-1;}for(auto& previous:clipNotes)if(&previous!=&*active&&previous.end>=0&&previous.instance==instance&&previous.note==pitch&&previous.channel==channel){clipEmit(MidiMessage::noteOff(channel,pitch),sample);previous.end=-1;previous.bank.reset();}
  double skipped=jmax(0.,position-note.start),duration=jmax(.0001,jmin(note.length-skipped,clipEnd(slot)-jmax(position,note.start))/clipRate(slot));*active={beat+duration,pitch,channel,slot,beat,false,mpe,index,slot,std::move(bank)};active->instance=instance;active->curveOffset=(float)jlimit(0.,1.,skipped/note.length);if(mpe)clipExpression(*active,sample,true);float velocity=note.velocity*(cx[slot][6]>.5f?state.velocity:1.f);clipEmit(MidiMessage::noteOn(channel,pitch,jlimit(.001f,1.f,velocity)),sample);
 }
 void updateClipNotes(int sample){for(auto& active:clipNotes)if(active.end>=0){if(beat+1.e-9>=active.end){clipEmit(MidiMessage::noteOff(active.channel,active.note),sample);active.end=-1;active.bank.reset();}else if(active.mpe&&sample%32==0)clipExpression(active,sample,false);}}
 void processClipInstance(std::shared_ptr<const SequencerBank> bank,int id,int sample,double increment,double hostOffset,bool running){auto& state=clipInstance(id);int slot=state.clipSlot;if(slot<0||slot>11)return;if(state.pending>=0&&running&&beat+1.e-9>=state.pending){if(v("seqClipPoly")<.5f)for(int other=0;other<76;++other)if(other!=id&&!(cv[slot][4]==2&&clipInstance(other).clipSlot==slot))stopClipInstance(other,sample);double launch=state.pending;state.on=true;state.pending=-1;state.launch=cx[slot][5]>.5f?launch:-hostOffset;double begin=clipBegin(slot);state.offset=positiveWrap(jmax(begin,(double)cx[slot][2])-begin+state.keyOffset,jmax(.0625,clipEnd(slot)-begin));state.first=true;state.randomEpoch=-1;}
  if(!state.on||!running)return;double begin=clipBegin(slot),end=clipEnd(slot),length=jmax(.0625,end-begin),rate=clipRate(slot),elapsed=jmax(0.,(beat-state.launch)*rate)+state.offset;int mode=(int)cv[slot][1];if(mode==3&&elapsed>=length){stopClipInstance(id,sample);return;}int64 previousEpoch=state.randomEpoch;double position=clipPosition(slot,state,true),delta=increment*rate,phase=position-begin;bool jumped=previousEpoch!=state.randomEpoch;bool reverse=mode==1||mode==2&&((int64)std::floor(elapsed/length)&1);for(int index=0;index<(int)bank->clips[slot].notes.size();++index){auto& note=bank->clips[slot].notes[index];if(note.start<begin||note.start>=end)continue;double target=reverse?jmax(0.,end-note.start-note.length):note.start-begin;if(!reverse)target=jmin(length-1.e-8,swingTime(target,.5));double current=mode<=3?positiveWrap(elapsed,length):phase;bool wrapped=std::floor((elapsed+1.e-9)/length)>std::floor((elapsed-delta+1.e-9)/length);bool due=(target>current-delta+1.e-9&&target<=current+1.e-9)||(wrapped&&std::abs(target)<1.e-9);if(mode>=4&&mode<=7)due=(target>current-delta+1.e-9&&target<=current+1.e-9)||jumped&&note.start<=position&&position<note.start+note.length;if(state.first&&note.start<=position&&position<note.start+note.length)due=true;if(mode==8)due=state.first&&note.start<=position&&position<note.start+note.length;if(due)playClipNote(bank,slot,index,id,sample,reverse?note.start:position);}state.first=false;
 }


