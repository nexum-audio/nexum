#pragma once
#include "OscExtensions.h"
#include "Expansion.h"
#include "AutomationSlider.h"
namespace noctrl {
class OscKnob:public juce::Component {
 juce::Label label;std::unique_ptr<juce::AudioProcessorValueTreeState::SliderAttachment> attachment;
public:
 AutomationSlider slider;
 OscKnob(SynthProcessor& p,juce::String id,juce::String title,bool numeric=false){using namespace juce;setComponentID("control:"+id);addAndMakeVisible(label);addAndMakeVisible(slider);label.setText(title,dontSendNotification);label.setFont(FontOptions(9,Font::bold));label.setJustificationType(Justification::centred);label.setColour(Label::textColourId,Colour(0xff8ba0ae));label.setInterceptsMouseClicks(false,false);slider.setSliderStyle(numeric?Slider::LinearBar:Slider::RotaryHorizontalVerticalDrag);slider.setTextBoxStyle(numeric?Slider::TextBoxLeft:Slider::TextBoxBelow,false,numeric?68:49,15);slider.setRotaryParameters(MathConstants<float>::pi*1.24f,MathConstants<float>::pi*2.76f,true);auto* parameter=p.state.getParameter(id);slider.bindAutomation(parameter);getProperties().set("parameterIndex",parameter->getParameterIndex());attachment=std::make_unique<AudioProcessorValueTreeState::SliderAttachment>(p.state,id,slider);slider.setDoubleClickReturnValue(true,parameter->convertFrom0to1(parameter->getDefaultValue()));slider.setTooltip(title+" / right-click for automation");slider.textFromValueFunction=[id](double value){if(id.endsWith("cut"))return value>=1000?String(value/1000,1)+"k":String((int)value)+"Hz";if(id.endsWith("fine"))return String(value,1)+"ct";if(id=="noisePitch")return String(value,1)+"st";if(id.endsWith("oct")||id.endsWith("Oct")||id.endsWith("semi")||id.endsWith("voices")||id=="polyphony")return String((int)std::round(value));if(id.contains("env")&&!id.endsWith("s")||id=="glide")return value<1?String((int)(value*1000))+"ms":String(value,2)+"s";if(id.endsWith("rate"))return String(value,2)+"Hz";if(id.endsWith("phase")&&id.startsWith("osc"))return String((int)value)+juce::String::charToString(0xb0);return String((int)std::round(value*100))+"%";};slider.valueFromTextFunction=[id](const String& text){double v=text.getDoubleValue();if(id.endsWith("cut"))return text.containsIgnoreCase("k")?v*1000:v;if(id=="noisePitch"||id.endsWith("fine")||id.endsWith("oct")||id.endsWith("Oct")||id.endsWith("semi")||id.endsWith("voices")||id=="polyphony"||id.endsWith("rate")||id.startsWith("osc")&&id.endsWith("phase"))return v;if(id.contains("env")&&!id.endsWith("s")||id=="glide")return text.containsIgnoreCase("ms")?v/1000:v;return v/100;};slider.updateText();}
 void setTitle(juce::String text){label.setText(text,juce::dontSendNotification);}
 void resized()override{label.setBounds(0,0,getWidth(),12);slider.setBounds(0,12,getWidth(),getHeight()-12);}
 void mouseDown(const juce::MouseEvent& e)override{if(e.mods.isPopupMenu())slider.showAutomationMenu(slider.getLocalPoint(this,e.getPosition()));}
};
class OscPage:public juce::Component,private juce::Timer {
 using Attachment=juce::AudioProcessorValueTreeState::ComboBoxAttachment;using ToggleAttachment=juce::AudioProcessorValueTreeState::ButtonAttachment;
 SynthProcessor& p;juce::OwnedArray<OscKnob> knobs;juce::OwnedArray<juce::ComboBox> choices;juce::OwnedArray<juce::TextButton> buttons;std::vector<std::unique_ptr<Attachment>> comboLinks;std::vector<std::unique_ptr<ToggleAttachment>> toggleLinks;
 std::array<std::vector<juce::Component*>,4> envWidgets;std::array<std::vector<juce::Component*>,8> lfoWidgets;std::array<std::vector<juce::Component*>,2> filterWidgets;
 std::array<juce::TextButton*,4> envTabs{};std::array<juce::TextButton*,8> lfoTabs{};std::array<juce::TextButton*,2> filterTabs{};std::array<juce::TextButton*,4> assetButtons{};std::array<OscKnob*,3> positionKnobs{};std::array<juce::ComboBox*,3> banks{},loops{};
 std::unique_ptr<juce::FileChooser> chooser;int envIndex=0,lfoIndex=0,filterIndex=0;
 struct Canvas:juce::Component{OscPage& page;bool lfo;int last=-1;Canvas(OscPage& p,bool l):page(p),lfo(l){setComponentID(l?"lfo-canvas":"envelope-canvas");setMouseCursor(l?juce::MouseCursor::CrosshairCursor:juce::MouseCursor::NormalCursor);}void paint(juce::Graphics& g)override{page.paintCanvas(g,getLocalBounds().toFloat(),lfo);}void mouseDown(const juce::MouseEvent& e)override{last=-1;if(lfo&&!e.mods.isPopupMenu())draw(e.position);}void mouseDrag(const juce::MouseEvent& e)override{if(lfo&&!e.mods.isPopupMenu())draw(e.position);}void mouseUp(const juce::MouseEvent&)override{last=-1;}void draw(juce::Point<float> point){int k=juce::jlimit(0,15,juce::roundToInt(point.x/juce::jmax(1,getWidth()-1)*15));float value=juce::jlimit(-1.f,1.f,1-2*point.y/juce::jmax(1,getHeight()-1));juce::String id="lfo"+juce::String(page.lfoIndex+1);page.p.set(id+"shape",4);page.p.set(id+"edited",1);if(last>=0){float previous=page.p.value(id+"point"+juce::String(last+1));int start=juce::jmin(last,k),end=juce::jmax(last,k);for(int at=start;at<=end;++at){float t=last==k?1.f:(at-last)/(float)(k-last);page.p.set(id+"point"+juce::String(at+1),previous+(value-previous)*t);}}else page.p.set(id+"point"+juce::String(k+1),value);last=k;repaint();}};
 Canvas envelope{*this,false},lfoCurve{*this,true};juce::Colour blue{0xff48aaff},muted{0xff899aa5};
 void timerCallback()override{auto assets=std::atomic_load(&p.importedAssets);for(int osc=0;osc<3;++osc){bool wavetable=(int)p.value("osc"+juce::String(osc+1)+"source")==0;positionKnobs[osc]->setTitle(wavetable?"WT POS":"START");banks[osc]->setVisible(wavetable);loops[osc]->setVisible(!wavetable);}for(int o=0;o<4;++o){juce::String title=o==3?"LOAD NOISE":"LOAD WT / SAMPLE";if(assets){if(o==3&&assets->expansion&&assets->expansion->noise)title=assets->expansion->noise->name;else if(o<3){if(assets->tables[o]&&(int)p.value("osc"+juce::String(o+1)+"source")==0)title=assets->tables[o]->name;else if(assets->expansion)title=assets->expansion->osc[o].sampleName.isEmpty()?title:assets->expansion->osc[o].sampleName;}}assetButtons[o]->setButtonText(juce::File::createLegalFileName(title.replaceCharacter('\\','/').fromLastOccurrenceOf("/",false,false)));}repaint();envelope.repaint();lfoCurve.repaint();}
 void title(juce::Graphics& g,juce::String text,juce::Rectangle<float> r,float size=11,juce::Colour colour=juce::Colour(0xff899aa5)){g.setColour(colour);g.setFont(juce::FontOptions(size,juce::Font::bold));g.drawText(text,r,juce::Justification::centredLeft,true);}
 OscKnob* knob(juce::String id,juce::String label,int x,int y,int w,int h,bool numeric=false){auto* k=knobs.add(new OscKnob(p,id,label,numeric));addAndMakeVisible(k);k->setBounds(x,y,w,h);return k;}
 juce::ComboBox* choice(juce::String id,int x,int y,int w,int h=23){using namespace juce;auto* c=choices.add(new ComboBox());auto* param=dynamic_cast<AudioParameterChoice*>(p.state.getParameter(id));c->addItemList(param->choices,1);c->getProperties().set("parameterIndex",param->getParameterIndex());c->setTooltip(param->getName(100));c->setComponentID("choice:"+id);addAndMakeVisible(c);c->setBounds(x,y,w,h);comboLinks.push_back(std::make_unique<Attachment>(p.state,id,*c));return c;}
 juce::TextButton* button(juce::String label,int x,int y,int w,int h,std::function<void()> action){auto* b=buttons.add(new juce::TextButton(label));addAndMakeVisible(b);b->setBounds(x,y,w,h);b->onClick=std::move(action);return b;}
 juce::TextButton* toggle(juce::String id,juce::String label,int x,int y,int w,int h=23){auto* b=button(label,x,y,w,h,{});b->setClickingTogglesState(true);b->getProperties().set("parameterIndex",p.state.getParameter(id)->getParameterIndex());toggleLinks.push_back(std::make_unique<ToggleAttachment>(p.state,id,*b));return b;}
 void setSelections(){for(int e=0;e<4;++e){envTabs[e]->setToggleState(e==envIndex,juce::dontSendNotification);for(auto* c:envWidgets[e])c->setVisible(e==envIndex);}for(int l=0;l<8;++l){lfoTabs[l]->setToggleState(l==lfoIndex,juce::dontSendNotification);for(auto* c:lfoWidgets[l])c->setVisible(l==lfoIndex);}for(int f=0;f<2;++f){filterTabs[f]->setToggleState(f==filterIndex,juce::dontSendNotification);for(auto* c:filterWidgets[f])c->setVisible(f==filterIndex);}repaint();}
 void loadAsset(int osc){int mode=osc==3?1:(int)p.value("osc"+juce::String(osc+1)+"source");chooser=std::make_unique<juce::FileChooser>(mode==4?"Load SFZ multisample":"Load WAV wavetable or sample",juce::File::getSpecialLocation(juce::File::userDocumentsDirectory),mode==4?"*.sfz":"*.wav;*.flac;*.aif;*.aiff");auto safe=juce::Component::SafePointer<OscPage>(this);chooser->launchAsync(juce::FileBrowserComponent::openMode|juce::FileBrowserComponent::canSelectFiles,[safe,osc,mode](const juce::FileChooser& fc){if(!safe||fc.getResult()==juce::File())return;juce::String error;if(!safe->p.loadOscillatorAsset(osc,fc.getResult(),mode,error))juce::AlertWindow::showMessageBoxAsync(juce::MessageBoxIconType::WarningIcon,"Asset could not be loaded",error);});}
public:
 std::function<void()> onImportInfo;
 explicit OscPage(SynthProcessor& processor):p(processor){using namespace juce;setComponentID("osc-page");setOpaque(true);
  toggle("subEnabled","SUB",3,2,68,22);toggle("noiseEnabled","NOISE",849,2,72,22);choice("subShape",3,32,69);knob("subOct","OCT",0,69,75,42,true);knob("subPan","PAN",1,215,72,61);knob("sub","LEVEL",1,288,72,70);
  for(int o=0;o<3;++o){int x=78+o*256;String id="osc"+String(o+1);toggle(id+"enabled",String::charToString('A'+o),x+4,2,30,22);choice(id+"source",x+40,2,205);assetButtons[o]=button("LOAD WT / SAMPLE",x+5,29,240,23,[this,o]{loadAsset(o);});knob(id+"oct","OCT",x+2,56,80,37,true);knob(id+"semi","SEMI",x+85,56,80,37,true);knob(id+"fine","FINE",x+167,56,80,37,true);banks[o]=choice(id+"bank",x+5,164,240,22);loops[o]=choice(id+"loop",x+5,164,240,22);loops[o]->setVisible(false);knob(id+"phase","PHASE",x+3,190,120,34,true);knob(id+"random","RAND",x+127,190,120,34,true);const String ids[]={"pos","voices","detune","blend","pan"},names[]={"WT POS","UNISON","DETUNE","BLEND","PAN"};for(int k=0;k<5;++k){auto* control=knob(id+ids[k],names[k],x+k*50,227,50,60);if(k==0)positionKnobs[o]=control;}choice(id+"warp1mode",x+4,292,94,21);choice(id+"warp2mode",x+102,292,94,21);knob(id+"warp1","WARP A",x+5,316,93,43);knob(id+"warp2","WARP B",x+103,316,93,43);knob(id+"level","LEVEL",x+199,292,49,68);choice(id+"routing",x+5,364,240,22);}
  assetButtons[3]=button("LOAD NOISE",849,137,73,25,[this]{loadAsset(3);});knob("noisePitch","PITCH",846,179,78,43,true);knob("noisePan","PAN",848,230,73,62);knob("noise","LEVEL",848,298,73,63);
  for(int f=0;f<2;++f){String id="filter"+String(f+1);filterTabs[f]=button("FILTER "+String(f+1),934+f*134,2,130,23,[this,f]{filterIndex=f;setSelections();});filterWidgets[f].push_back(choice(id+"type",934,33,266));filterWidgets[f].push_back(knob(id+"cut","CUTOFF",931,150,95,77));filterWidgets[f].push_back(knob(id+"res","RES",1026,150,86,77));filterWidgets[f].push_back(knob(id+"pan","PAN",1117,150,86,77));filterWidgets[f].push_back(knob(id+"drive","DRIVE",946,237,110,73));filterWidgets[f].push_back(knob(id+"wet","MIX",1084,237,110,73));}
  toggle("filterSerial","SERIAL  1 > 2",938,327,259,25);
  for(int m=0;m<8;++m)knob("macro"+String(m+1),"MACRO "+String(m+1),3+(m/4)*87,428+(m%4)*61,82,60);
  for(int e=0;e<4;++e){envTabs[e]=button("ENV "+String(e+1),185+e*86,402,83,23,[this,e]{envIndex=e;setSelections();});String id="env"+String(e+1);const String ids[]={"a","hold","d","s","r"},labels[]={"ATTACK","HOLD","DECAY","SUSTAIN","RELEASE"};for(int k=0;k<5;++k)envWidgets[e].push_back(knob(id+ids[k],labels[k],187+k*68,567,67,76));}
  addAndMakeVisible(envelope);envelope.setBounds(191,437,332,117);for(int l=0;l<8;++l){lfoTabs[l]=button("LFO "+String(l+1),541+l*55,402,53,23,[this,l]{lfoIndex=l;setSelections();});String id="lfo"+String(l+1);lfoWidgets[l].push_back(choice(id+"shape",547,553,112));lfoWidgets[l].push_back(choice(id+"sync",666,553,115));lfoWidgets[l].push_back(toggle(id+"retrigger","RETRIG",789,553,92));lfoWidgets[l].push_back(toggle(id+"oneshot","ONE SHOT",888,553,92));lfoWidgets[l].push_back(knob(id+"rate","RATE",560,589,100,67));lfoWidgets[l].push_back(knob(id+"phase","PHASE",683,589,100,67));if(l<2)lfoWidgets[l].push_back(knob(id+"depth",l==0?"TO FILTER":"TO WT POS",817,589,144,67));}
  addAndMakeVisible(lfoCurve);lfoCurve.setBounds(549,437,426,105);toggle("mono","MONO",1002,434,91);knob("polyphony","POLY",1101,428,95,58,true);knob("glide","PORTA",1004,487,92,60);knob("output","MAIN",1103,487,92,60);const String ids[]={"drive","chorus","delay","reverb"},labels[]={"DRIVE","CHORUS","DELAY","REVERB"};for(int k=0;k<4;++k)knob(ids[k],labels[k],1000+k*51,552,50,58);choice("delayTime",1003,617,134,23);knob("feedback","FEEDBACK",1142,613,61,55);toggle("arp","ARP",1003,648,67);button("IMPORT INFO",1075,648,126,23,[this]{if(onImportInfo)onImportInfo();});setSelections();startTimerHz(20);
 }
 ~OscPage()override{stopTimer();}
 void paint(juce::Graphics& g)override{using namespace juce;g.fillAll(Colour(0xff12191d));g.setColour(Colour(0xff1e2b32));for(auto r:{Rectangle<float>(0,0,74,390),Rectangle<float>(78,0,250,390),Rectangle<float>(334,0,250,390),Rectangle<float>(590,0,250,390),Rectangle<float>(846,0,78,390),Rectangle<float>(928,0,280,390),Rectangle<float>(0,398,177,282),Rectangle<float>(182,398,350,282),Rectangle<float>(538,398,450,282),Rectangle<float>(994,398,214,282)})g.fillRoundedRectangle(r,4);title(g,"MACROS",{13,402,150,23},12,blue);title(g,"VOICING / FX",{1004,402,195,23},12,blue);title(g,"Drag the LFO display to draw a custom curve",{548,660,430,16},9);title(g,"ENV 1 controls amplitude. ENV 2-4: use Matrix.",{192,658,334,16},8);
 auto imported=std::atomic_load(&p.importedAssets);for(int o=0;o<3;++o){int x=78+o*256;Rectangle<float> r((float)x+5,98,240,61);g.setColour(Colour(0xff0c1216));g.fillRect(r);String id="osc"+String(o+1);bool enabled=p.value(id+"enabled")>.5f;int mode=(int)p.value(id+"source");Path wave;for(int i=0;i<240;++i){float t=i/239.f,v=0;auto* table=imported?imported->tables[o].get():nullptr;if(mode>0&&imported&&imported->expansion){auto sample=imported->expansion->osc[o].sample;if(mode==4)for(auto& region:imported->expansion->osc[o].regions)if(region.sample){sample=region.sample;break;}if(sample)v=sample->read(t*(sample->audio.getNumSamples()-1),0,false);}else{int bank=(int)p.value(id+"bank");v=bank==4?(table?table->sample(p.value(id+"pos"),t*.999,110,48000):0.f):p.tables.sample(jmin(3,bank),p.value(id+"pos"),t*.999,110,48000);}float px=r.getX()+t*r.getWidth(),py=r.getCentreY()-v*25;if(i==0)wave.startNewSubPath(px,py);else wave.lineTo(px,py);}g.setColour(enabled?blue:muted.withAlpha(.3f));g.strokePath(wave,PathStrokeType(1.6f));}
 Rectangle<float> filter(938,67,260,71);g.setColour(Colour(0xff0c1216));g.fillRect(filter);Path response;float cutoff=p.value("filter"+String(filterIndex+1)+"cut");int type=(int)p.value("filter"+String(filterIndex+1)+"type");for(int i=0;i<260;++i){float hz=20*std::pow(1000.f,i/259.f),ratio=hz/cutoff,lp=1/std::sqrt(1+std::pow(ratio,4.f)),v=type==0?lp:type==1?1-lp:type==2?2*ratio/(1+ratio*ratio):1;float x=filter.getX()+i,y=filter.getBottom()-6-v*55;if(i==0)response.startNewSubPath(x,y);else response.lineTo(x,y);}g.setColour(blue);g.strokePath(response,PathStrokeType(1.6f));title(g,"RESPONSE / APPROXIMATE",{943,118,240,15},8);
 Path sub;for(int i=0;i<65;++i){float value=std::sin(i/64.f*MathConstants<float>::twoPi);if(i==0)sub.startNewSubPath(5,155-value*22);else sub.lineTo(5.f+i,155-value*22);}g.setColour(blue.withAlpha(.6f));g.strokePath(sub,PathStrokeType(1.5f));if(imported&&imported->expansion&&imported->expansion->noise){auto sample=imported->expansion->noise;Path noise;for(int i=0;i<70;++i){float v=sample->read(i/69.f*(sample->audio.getNumSamples()-1),0,false);if(i==0)noise.startNewSubPath(850,78-v*43);else noise.lineTo(850.f+i,78-v*43);}g.strokePath(noise,PathStrokeType(1));}title(g,"NATIVE / v0.5",{2,667,165,12},8);}
 void paintCanvas(juce::Graphics& g,juce::Rectangle<float> r,bool lfo){using namespace juce;g.fillAll(Colour(0xff0d151b));g.setColour(Colour(0xff25343e));for(int i=1;i<8;++i)g.drawVerticalLine((int)(r.getWidth()*i/8),0,r.getHeight());for(int i=1;i<4;++i)g.drawHorizontalLine((int)(r.getHeight()*i/4),0,r.getWidth());Path path;if(lfo){String id="lfo"+String(lfoIndex+1);int shape=(int)p.value(id+"shape");auto assets=std::atomic_load(&p.importedAssets);for(int i=0;i<320;++i){float t=i/319.f,value;if(shape==4&&assets&&assets->expansion&&p.value(id+"edited")<.5f)value=assets->expansion->lfo[lfoIndex].curve[(size_t)jmin(255,(int)(t*255))];else if(shape==4){float at=t*15;int k=jmin(14,(int)at);float a=p.value(id+"point"+String(k+1)),b=p.value(id+"point"+String(k+2));value=a+(at-k)*(b-a);}else value=lfoWave(t*.9999,shape);float x=3+t*(r.getWidth()-6),y=r.getCentreY()-value*(r.getHeight()*.44f);if(i==0)path.startNewSubPath(x,y);else path.lineTo(x,y);}}else{String id="env"+String(envIndex+1);float a=p.value(id+"a"),h=p.value(id+"hold"),d=p.value(id+"d"),s=p.value(id+"s"),rel=p.value(id+"r"),total=a+h+d+rel+.25f;auto x=[&](float t){return 4+t/total*(r.getWidth()-8);};path.startNewSubPath(x(0),r.getHeight()-4);path.lineTo(x(a),4);path.lineTo(x(a+h),4);path.lineTo(x(a+h+d),r.getHeight()-4-s*(r.getHeight()-8));path.lineTo(x(a+h+d+.25f),r.getHeight()-4-s*(r.getHeight()-8));path.lineTo(x(total),r.getHeight()-4);}g.setColour(blue);g.strokePath(path,PathStrokeType(2));}
};
}
